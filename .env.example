# ===== Tentacle HRV 环境变量模板 =====
# 使用方法：复制本文件为 .env 并填写真实值：
#   cp .env.example .env   （Windows: copy .env.example .env）
# .env 已被 .gitignore 忽略，不会提交到仓库；本模板文件可安全提交。

# ---- AI 模型与 API ----
# DeepSeek API 密钥（必填，从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=你的DeepSeek密钥
# 使用的多模态模型（需支持视觉输入）。官方正式名：deepseek-flash
# 注意：旧别名 deepseek-v4-flash-vision-exp 已下线，别名摘除后会全链 400
DEEPSEEK_MODEL=deepseek-flash
# DeepSeek API 基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 单次 API 调用超时（秒）
DEEPSEEK_TIMEOUT=30
# 单次输出预算（tokens）。本项目产出为「3~5 句剧情 + 1 行指令」；
# 推理型模型的 reasoning 也计入该预算，过小会导致正文空回复，1800 为实测平衡点
DEEPSEEK_MAX_TOKENS=1800
# thinking 控制：enabled=带推理（默认，剧情质量优先）
#                disabled=关闭推理（最快最省，剧情质量可能下降）
#                auto=不传该参数（由服务端默认行为决定）
DEEPSEEK_THINKING=enabled
# thinking 预算（tokens），仅在 DEEPSEEK_THINKING=enabled 时生效
DEEPSEEK_THINKING_BUDGET=1024

# ---- ESP32 串口 ----
# ESP32 所在串口（Windows 示例 COM3；Linux/macOS 通常为 /dev/ttyUSB0）
SERIAL_PORT=COM3
# 串口波特率，须与固件一致
SERIAL_BAUD=115200

# ---- 闭环控制 ----
# 拍照 / 决策循环间隔（秒）
INTERVAL_SECONDS=3

# ---- 图像参数 ----
# 上传图片压缩后的最大宽度（像素），用于降低 API 流量
IMAGE_MAX_WIDTH=640
# 图片视为过旧、暂停 AI 调用的时间阈值（秒）
IMAGE_STALE_TIMEOUT=10
